---
import '../styles/global.css';
import { site, url } from '../lib/site';
import { works } from '../data/works';
const { title = site.name, description = site.description, image = 'seasons-planet.jpg' } = Astro.props;
const pageTitle = title === site.name ? `${site.name} · ${site.englishName}` : `${title} · ${site.name}`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfcfd" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(url(`covers/${image}`), Astro.site || Astro.url.origin).href} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" type="image/png" sizes="256x256" href={url('logo.png')} />
    <link rel="apple-touch-icon" href={url('logo.png')} />
    <title>{pageTitle}</title>
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到内容</a>
    <header class="site-header shell" data-header>
      <a class="brand" href={url()} aria-label={`${site.name}首页`}><img class="brand-logo" src={url('logo.png')} alt="" width="52" height="52" /><span>{site.name}<small>{site.englishName}</small></span></a>
      <nav aria-label="主导航">
        <a class="nav-pill" href={url('#works')}>作品集 <span>{String(works.length).padStart(2, '0')}</span></a>
        <a class="nav-pill" href={url('about/')}>关于这里</a>
        {site.repository ? <a class="nav-github" href={site.repository} target="_blank" rel="noreferrer"><svg class="github-mark" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>GitHub ↗</a> : <a class="nav-github" href={url('about/#open-source')}>开源说明 ↗</a>}
        <a class="nav-myapi" href={site.myapi} target="_blank" rel="noopener" data-myapi="header"><img src={url('myapi.svg')} alt="" width="20" height="20" />MyAPI ↗</a>
      </nav>
    </header>
    <slot />
    <aside class="myapi-promo shell" aria-label="MyAPI 推荐">
      <a href={site.myapi} target="_blank" rel="noopener" data-myapi="footer">
        <img src={url('myapi.svg')} alt="" width="56" height="56" />
        <div><span>同一尾小鱼 · MYAPI</span><strong>想亲手试试 AI 创作？</strong><p>一个 API Key，接入 Claude、ChatGPT、Gemini 等主流模型，兼容 OpenAI SDK。</p></div>
        <em>前往 myapi.pw <span aria-hidden="true">↗</span></em>
      </a>
    </aside>
    <footer class="site-footer shell">
      <div><a class="footer-name" href={url()}><img class="footer-logo" src={url('logo.png')} alt="" width="30" height="30" />{site.name}</a><p>灵感不止于对话框。</p></div>
      <div class="footer-right"><p>MADE WITH CURIOSITY & AI</p><span>© 2026 · 作品与提示词持续归档中</span></div>
    </footer>
    <script>
      const header = document.querySelector('[data-header]');
      let lastY = scrollY;
      const onScroll = () => {
        const y = scrollY;
        header?.classList.toggle('scrolled', y > 8);
        header?.classList.toggle('tucked', y > 240 && y > lastY && !header.contains(document.activeElement));
        lastY = y;
      };
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });
      const reveals = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }), { rootMargin: '0px 0px -6% 0px' });
        reveals.forEach(element => observer.observe(element));
      } else reveals.forEach(element => element.classList.add('is-visible'));
    </script>
  </body>
</html>
