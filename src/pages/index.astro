---
import Layout from '../layouts/Layout.astro';
import { works } from '../data/works';
import { url } from '../lib/site';
const featured = works[0];
---
<Layout>
  <main id="main" class="shell">
    <section class="hero">
      <div class="eyebrow"><span class="status-dot"></span> A PERSONAL COLLECTION OF AI EXPERIMENTS</div>
      <div class="hero-row"><h1>脑海里的奇思妙想，<br />现在，<em>有了形状。</em><img class="hero-fish" src={url('logo.png')} alt="" width="76" height="76" /></h1><div class="hero-note"><span class="note-index">HELLO, WORLD / 001</span><p>和 AI 一起，把「如果可以」变成「真的可以」。<br />这里收藏我的创作实验，<br />也公开它们背后的提示词与制作过程。</p><a class="text-link" href="#works">往下逛逛 <span>↓</span></a></div></div>
    </section>

    <section id="works" class="works-section" aria-labelledby="works-title">
      <div class="section-top"><h2 id="works-title">创作档案 <span>/ SELECTED WORKS</span></h2><span class="archive-count"><span data-result-count>03</span> 件作品，持续生长中 ↗</span></div>
      <div class="filter-bar"><div class="filters" role="group" aria-label="按作品类型筛选"><button type="button" class="filter active" data-filter="all" aria-pressed="true">全部作品 <span>03</span></button><button type="button" class="filter" data-filter="交互世界" aria-pressed="false">交互世界 <span>02</span></button><button type="button" class="filter" data-filter="叙事动画" aria-pressed="false">叙事动画 <span>01</span></button></div><span class="filter-hint">每一个成品，都有迹可循。</span></div>
      <p class="sr-only" aria-live="polite" data-filter-status>显示全部 3 件作品</p>
      <div class="work-grid">
        {works.map((work, index) => <article class:list={['work-card', { featured: index === 0 }]} data-category={work.category}>
          <a class="work-image" style={`--cover-color:${work.color}`} href={url(`works/${work.slug}/`)} aria-label={`查看作品：${work.title}`}>
            <img src={url(`covers/${work.cover}`)} alt={`${work.title}的实际运行画面`} width="1440" height="900" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
            <span class="image-badge">{index === 0 ? '精选实验' : work.category}</span><span class="image-open" aria-hidden="true">↗</span>
            {index === 0 && <div class="feature-caption"><span>EXPERIMENT {featured.number} / INTERACTIVE WORLD</span><strong>一颗星球，四种心情。</strong><p>走慢一点，就能遇见下一个季节。</p></div>}
          </a>
          <div class="work-meta"><span class="work-number">{work.number} /</span><div><a href={url(`works/${work.slug}/`)}><h3>{work.title}</h3></a><p>{work.description}</p><div class="work-tags">{work.tools.slice(0, 2).map(tool => <span>{tool}</span>)}<span class="prompt-tag">复现参考提示词</span></div></div><a class="card-arrow" href={url(`works/${work.slug}/`)} aria-label={`查看${work.title}的创作档案`}>↗</a></div>
        </article>)}
      </div>
    </section>
    <aside class="manifesto"><span class="manifesto-icon" aria-hidden="true">↳</span><div><span class="eyebrow">NOT JUST THE OUTPUT</span><h2>不只分享结果，也分享起点。</h2><p>提示词、可运行源码、制作记录。让一次好奇，成为下一次创作的起点。</p></div><a href={url('about/')} class="round-link" aria-label="了解这个创作档案馆">↗</a></aside>
  </main>
  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-category]');
    filters.forEach(button => button.addEventListener('click', () => {
      const category = button.dataset.filter;
      let count = 0;
      cards.forEach(card => { card.hidden = category !== 'all' && card.dataset.category !== category; if (!card.hidden) count++; });
      filters.forEach(item => { const selected = item === button; item.classList.toggle('active', selected); item.setAttribute('aria-pressed', String(selected)); });
      const counter = document.querySelector('[data-result-count]');
      const status = document.querySelector('[data-filter-status]');
      if (counter) counter.textContent = String(count).padStart(2, '0');
      if (status) status.textContent = `显示${category === 'all' ? '全部' : category} ${count} 件作品`;
    }));
  </script>
</Layout>
